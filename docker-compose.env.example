# Copy to `.env` in this directory (`uk-bonn-survey-web/`).
# Used by docker compose for API + Mongo + Next.js.

# --- Secrets (required) ---
JWT_SECRET=replace-with-long-random-string

# --- Ports on the VPS ---
WEB_HOST_PORT=3000
API_HOST_PORT=4000

# --- Browser-visible API URL (must include trailing path /api) ---
# Use your public HTTPS URL after you put nginx/Caddy in front:
# NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.de/api
# Quick test without reverse proxy:
# NEXT_PUBLIC_API_BASE_URL=http://YOUR_VPS_IP:4000/api
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api

# --- Build path to API Dockerfile (repo layout) ---
API_BUILD_CONTEXT=../uk-bonn-survey-api

# --- Admin bootstrap / CORS ---
ADMIN_EMAILS=you@ukbonn.de
# Set to your real web origin in production:
CORS_ORIGIN=http://YOUR_VPS_IP:3000
FRONTEND_URL=http://YOUR_VPS_IP:3000
RESET_PASSWORD_BASE_URL=http://YOUR_VPS_IP:3000

# --- Optional SMTP ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=false

# SEND_SURVEY_COMPLETION_EMAIL=false
# SAVE_PDF_TO_DISK=true
